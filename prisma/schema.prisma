generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  registrationNumber String?
  taxNumber          String?
  industry           String
  country            String
  website            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  addressLine1       String?
  addressLine2       String?
  city               String?
  logoUrl            String?
  postalCode         String?
  province           String?
  subscriptionPlan   String?
  subscriptionStatus String?
  supportEmail       String?
  supportPhone       String?
  users              User[]
  verificationCases  VerificationCase[]
}

model User {
  id                String                @id @default(cuid())
  firstName         String
  lastName          String
  email             String                @unique
  phone             String?
  jobTitle          String?
  emailVerified     Boolean               @default(false)
  isActive          Boolean               @default(true)
  role              UserRole              @default(USER)
  companyId         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  authId            String?               @unique
  avatarUrl         String?
  notifications     NotificationSettings?
  notificationItems Notification[]
  security          SecuritySettings?
  company           Company?              @relation(fields: [companyId], references: [id])
  preferences       UserPreferences?
  verificationCases VerificationCase[]
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  theme            String   @default("light")
  language         String   @default("English")
  timezone         String   @default("Africa/Johannesburg")
  country          String   @default("South Africa")
  dateFormat       String   @default("DD/MM/YYYY")
  dashboardRefresh Int      @default(30)
  landingPage      String   @default("dashboard")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  sessionTimeout      Int       @default(30)
  maxLoginAttempts    Int       @default(3)
  failedLoginAttempts Int       @default(0)
  auditLogging        Boolean   @default(true)
  passwordExpiryDays  Int       @default(90)
  passwordExpiresAt   DateTime?
  lastLogin           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("system")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model NotificationSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  verificationAlerts Boolean  @default(true)
  weeklyReports      Boolean  @default(true)
  securityAlerts     Boolean  @default(true)
  productUpdates     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCase {
  id                String    @id @default(cuid())
  verificationId    String    @unique
  companyId         String?
  createdByUserId   String?
  subjectType       String
  subjectName       String?
  subjectIdentifier String?
  status            String    @default("Draft")
  recommendation    String?
  riskLevel         String?
  riskScore         Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  durationSeconds   Float?

  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  subject   VerificationSubject?
  checks    VerificationCheck[]
  results   VerificationResult[]
  providers VerificationProviderResult[]
  timeline  VerificationTimelineEvent[]
  reports   VerificationReport[]
  auditLogs VerificationAuditLog[]

  @@index([companyId])
  @@index([createdByUserId])
  @@index([status])
  @@index([createdAt])
}

model VerificationSubject {
  id                 String    @id @default(cuid())
  verificationCaseId String    @unique
  subjectType        String
  firstName          String?
  lastName           String?
  fullName           String?
  identifier         String?
  identifierType     String?
  dateOfBirth        DateTime?
  nationality        String?
  country            String?
  email              String?
  phone              String?
  companyName        String?
  registrationNumber String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([subjectType])
}

model VerificationCheck {
  id                 String    @id @default(cuid())
  verificationCaseId String
  checkKey           String
  checkName          String
  category           String?
  status             String    @default("Queued")
  provider           String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verificationCase VerificationCase     @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  results          VerificationResult[]

  @@unique([verificationCaseId, checkKey])
  @@index([verificationCaseId])
  @@index([status])
}

model VerificationResult {
  id                  String    @id @default(cuid())
  verificationCaseId  String
  verificationCheckId String?
  provider            String?
  status              String
  score               Float?
  message             String?
  evidence            Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  verificationCase  VerificationCase   @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  verificationCheck VerificationCheck? @relation(fields: [verificationCheckId], references: [id], onDelete: SetNull)

  @@index([verificationCaseId])
  @@index([verificationCheckId])
  @@index([status])
}

model VerificationProviderResult {
  id                 String   @id @default(cuid())
  verificationCaseId String
  providerName       String
  status             String
  confidence         Float?
  responseTime       Float?
  findings           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId])
  @@index([providerName])
}

model VerificationTimelineEvent {
  id                 String   @id @default(cuid())
  verificationCaseId String
  eventType          String
  status             String?
  message            String?
  createdAt          DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId])
  @@index([createdAt])
}

model VerificationReport {
  id                 String   @id @default(cuid())
  verificationCaseId String
  reportType         String
  fileUrl            String?
  generatedAt        DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId])
}

model VerificationAuditLog {
  id                 String   @id @default(cuid())
  verificationCaseId String
  userId             String?
  action             String
  details            Json?
  createdAt          DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId])
  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  USER
}
